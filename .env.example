# Inject these variables through your hosting platform or export them in your shell.
# server.py does not automatically load .env files.
MYSQL_HOST=easykashbackendreplica.ct8lliybav4s.us-east-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=easykash-live
MYSQL_USER=
MYSQL_PASSWORD=
# Path to the trusted Amazon RDS CA bundle installed on the server.
MYSQL_SSL_CA=
MCP_TRANSPORT=http
PORT=8000
MCP_PUBLIC_URL=https://easykashmcp.onrender.com
OAUTH_ISSUER=https://dev-sg8epu3k08rfskl8.us.auth0.com/
OAUTH_AUDIENCE=https://easykash-mcp
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Writable OAuth state directory. Use a persistent mounted directory in production.
FASTMCP_HOME=/tmp/fastmcp

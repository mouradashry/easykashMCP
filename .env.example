# Inject these variables through your hosting platform or export them in your shell.
# server.py does not automatically load .env files.
MYSQL_HOST=easykashbackendreplica.ct8lliybav4s.us-east-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=easykash-live
MYSQL_USER=
MYSQL_PASSWORD=
# Docker downloads the official us-east-1 RDS CA bundle at build time.
MYSQL_SSL_CA=/app/certs/rds-us-east-1-bundle.pem
MCP_TRANSPORT=http
PORT=8000
MCP_PUBLIC_URL=https://easykashmcp.onrender.com
OAUTH_ISSUER=https://dev-sg8epu3k08rfskl8.us.auth0.com/
OAUTH_AUDIENCE=https://easykash-mcp
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Redis protocol URL, not the provider's HTTPS REST URL. Set securely in Render.
REDIS_URL=
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this secret stable across deployments; never commit the generated value.
OAUTH_STORAGE_KEY=
